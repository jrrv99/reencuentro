# Copia a infra/.env  ->  cp .env.example .env
# Lo usan tanto docker-compose como la API Django (apps/api lee estas mismas vars).

# --- Postgres ---
POSTGRES_DB=reencuentro
POSTGRES_USER=reencuentro
POSTGRES_PASSWORD=reencuentro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (broker Celery + cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Django ---
DJANGO_SECRET_KEY=dev-inseguro-cambiar-en-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
